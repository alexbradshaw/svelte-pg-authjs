{
  "name": "svelte-pg-authjs",
  "version": "1",
  "private": true,
  "scripts": {
    "build": "docker compose up --force-recreate",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dbconnect": "bash ./src/db/connect.bash",
    "dev": "concurrently -c red,blue -n database,svelte --restart-tries 3 \"docker compose down -v && docker compose up --force-recreate db\" \"sleep 3 && vite dev --host\"",
    "format": "prettier --write . && eslint . --fix",
    "lint": "prettier --check . && eslint .",
    "preview": "vite preview",
    "prodbuild": "vite build"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^2.1.0",
    "@sveltejs/adapter-node": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/eslint": "^8.56.7",
    "@types/pg": "^8.11.6",
    "@unlighthouse/vite": "^0.10.6",
    "concurrently": "^9.0.1",
    "eslint": "^9.7.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-sql": "^2.5.0",
    "eslint-plugin-svelte": "^2.39.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.2",
    "prettier-plugin-svelte": "^3.2.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-eslint-parser": "^0.36.0",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.0.3"
  },
  "type": "module",
  "dependencies": {
    "@auth/pg-adapter": "^1.4.2",
    "@auth/sveltekit": "^1.2.0",
    "pg": "^8.12.0"
  }
}
